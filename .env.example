# ==============================================================================
# PV-Triage Environment Configuration (.env.example)
# Safe defaults are provided; secrets and sensitive identifiers are left blank.
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# LLM Configuration
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=http://stub-llm:8001

# Task Queue & Storage
REDIS_URL=redis://redis:6379/0
CHROMA_DIR=./data/chroma
EMBED_MODEL=all-MiniLM-L6-v2

# Prompt & Telemetry
PROMPT_VERSION=v1
OTLP_ENDPOINT=http://jaeger:4317

# Stub Behavior
STUB_DELAY_MS=50
STUB_FAIL=false

# Bounds & Execution Limits
MAX_STEPS=10
MAX_TOOL_CALLS=5
RUN_TIMEOUT_S=30
RATE_LIMIT_PER_MIN=60

# Cost Accounting ($ per 1k tokens)
PRICE_PER_1K_PROMPT=0.00015
PRICE_PER_1K_COMPLETION=0.00060

# Circuit Breaker Configuration
BREAKER_FAILS=3
BREAKER_RESET_S=30
